<Window x:Class="DeskWidgets.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
  <Grid>
    <wv:WebView2CompositionControl x:Name="Browser" Margin="6" />
    <Border x:Name="DragHandle" Width="38" Height="8" Margin="15,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" Cursor="SizeAll" ToolTip="拖动位置：虚框预览，松手放置">
      <Border Width="24" Height="2" Background="#667DD3FC" CornerRadius="1" />
    </Border>

    <Grid x:Name="ResizeHandles">
      <Border Height="10" VerticalAlignment="Top" Margin="16,0,16,0" Background="#01000000" Cursor="SizeNS" Tag="12" MouseLeftButtonDown="ResizePointerDown" />
      <Border Height="10" VerticalAlignment="Bottom" Margin="30,0,30,0" Background="#01000000" Cursor="SizeNS" Tag="15" MouseLeftButtonDown="ResizePointerDown" />
      <Border Width="10" HorizontalAlignment="Left" Margin="0,16,0,30" Background="#01000000" Cursor="SizeWE" Tag="10" MouseLeftButtonDown="ResizePointerDown" />
      <Border Width="10" HorizontalAlignment="Right" Margin="0,16,0,30" Background="#01000000" Cursor="SizeWE" Tag="11" MouseLeftButtonDown="ResizePointerDown" />
      <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" Cursor="SizeNWSE" Tag="13" MouseLeftButtonDown="ResizePointerDown" />
      <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01000000" Cursor="SizeNESW" Tag="14" MouseLeftButtonDown="ResizePointerDown" />
      <Border Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01000000" Cursor="SizeNESW" Tag="16" MouseLeftButtonDown="ResizePointerDown"><Border.Clip><PathGeometry Figures="M 0,0 L 30,30 L 0,30 Z" /></Border.Clip></Border>
      <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000" Cursor="SizeNWSE" Tag="17" MouseLeftButtonDown="ResizePointerDown" ToolTip="拖动此角调整宽高：虚框预览，松手应用">
        <Border.Clip><PathGeometry Figures="M 0,30 L 30,0 L 30,30 Z" /></Border.Clip>
        <Path Data="M 8,24 L 24,8 M 15,24 L 24,15 M 22,24 L 24,22" Stroke="#AA9BDCF5" StrokeThickness="1.5" IsHitTestVisible="False" />
      </Border>
    </Grid>
  </Grid>
</Window>
